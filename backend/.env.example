# ==============================================================================
# Nexora Backend Environment Variables Example
# Copy to .env for local development. NEVER commit a real .env file.
# ==============================================================================

# Active Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nexora
DB_USER=nexora_app
DB_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD

# CORS Allowed Frontend Origins (comma-separated, never use * with credentials)
NEXORA_CORS_ALLOWED_ORIGINS=http://localhost:4200

